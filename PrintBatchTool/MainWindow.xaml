<Window x:Class="BatchPrinterTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="批量文件打印助手" Height="600" Width="800" WindowStartupLocation="CenterScreen" Background="#F0F0F0"
        Icon="AppIcon.ico"
        >
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 打印机选择 -->
            <RowDefinition Height="Auto"/>
            <!-- 文件夹扫描 -->
            <RowDefinition Height="*"/>
            <!-- 文件统计与列表 -->
            <RowDefinition Height="Auto"/>
            <!-- 设置与执行 -->
        </Grid.RowDefinitions>

        <!-- 1. 打印机设置区域 -->
        <GroupBox Header="1. 打印机连接状态" Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="当前目标打印机：" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtCurrentPrinter" Text="正在检测..." VerticalAlignment="Center" Margin="10,0" Foreground="Blue"/>
                    <Button x:Name="BtnChangePrinter" Content="重新指定打印机" Click="BtnChangePrinter_Click" Visibility="Collapsed" Padding="5,2"/>
                </StackPanel>

                <!-- 打印机选择下拉框 (默认隐藏) -->
                <StackPanel x:Name="PanelPrinterSelect" Orientation="Horizontal" Margin="0,5" Visibility="Collapsed">
                    <TextBlock Text="请选择可用打印机：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ComboPrinters" Width="250" Margin="10,0" SelectionChanged="ComboPrinters_SelectionChanged"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 2. 文件夹扫描区域 -->
        <GroupBox Header="2. 文件目录扫描" Grid.Row="1" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtFolderPath" IsReadOnly="True" VerticalAlignment="Center" Height="26" Text="请选择包含文件的根目录..."/>
                <Button Grid.Column="1" Content="选择目录" Width="100" Height="26" Margin="10,0,0,0" Click="BtnSelectFolder_Click"/>
            </Grid>
        </GroupBox>

        <!-- 3. 文件统计区域 -->
        <GroupBox Header="3. 文件检索结果" Grid.Row="2" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 统计标签 -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemWidth="110" Margin="0,0,0,10">
                    <CheckBox x:Name="ChkPdf" Content="PDF (0)" Tag=".pdf" Click="ExtensionCheckBox_Click"/>
                    <CheckBox x:Name="ChkDoc" Content="DOC (0)" Tag=".doc" Click="ExtensionCheckBox_Click"/>
                    <CheckBox x:Name="ChkDocx" Content="DOCX (0)" Tag=".docx" Click="ExtensionCheckBox_Click"/>
                    <CheckBox x:Name="ChkXls" Content="XLS (0)" Tag=".xls" Click="ExtensionCheckBox_Click"/>
                    <CheckBox x:Name="ChkXlsx" Content="XLSX (0)" Tag=".xlsx" Click="ExtensionCheckBox_Click"/>
                    <CheckBox x:Name="ChkTxt" Content="TXT (0)" Tag=".txt" Click="ExtensionCheckBox_Click"/>
                    <CheckBox x:Name="ChkPpt" Content="PPT (0)" Tag=".ppt" Click="ExtensionCheckBox_Click"/>
                    <CheckBox x:Name="ChkPptx" Content="PPTX (0)" Tag=".pptx" Click="ExtensionCheckBox_Click"/>
                </WrapPanel>

                <!-- 手动添加文件列表 -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="待打印文件列表 (可手动添加):" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Content="+ 手动添加文件" Margin="10,0" Padding="5,2" Click="BtnAddManualFile_Click"/>
                        <Button Content="清空列表" Margin="5,0" Padding="5,2" Click="BtnClearList_Click"/>
                    </StackPanel>
                    <ListBox x:Name="ListFilesToPrint" Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- 4. 打印设置与执行 -->
        <GroupBox Header="4. 打印配置与执行" Grid.Row="3" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="颜色模式：" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ComboColor" Width="100" Margin="5,0,20,0" SelectedIndex="0">
                            <ComboBoxItem Content="黑白 (Monochrome)"/>
                            <ComboBoxItem Content="彩色 (Color)"/>
                        </ComboBox>

                        <TextBlock Text="双面打印：" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ComboDuplex" Width="120" Margin="5,0,20,0" SelectedIndex="0">
                            <ComboBoxItem Content="单面打印"/>
                            <ComboBoxItem Content="双面 (长边翻转)"/>
                            <ComboBoxItem Content="双面 (短边翻转)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 新增：交互模式选项 -->
                    <CheckBox x:Name="ChkInteractiveMode" Content="交互模式：每打印一份后暂停 (适用于PDF虚拟打印机)" 
                              IsChecked="False" Foreground="Red" FontWeight="Bold" Margin="0,5,0,0"
                              ToolTip="勾选此项后，程序会在发送每个打印任务后弹出确认框，等待您处理完保存窗口后再继续。"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnStartPrint" Content="开始批量打印" FontWeight="Bold" FontSize="14" Width="150" Height="35" Click="BtnStartPrint_Click" IsEnabled="False"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>

